# -----------------------------------------------------------------------------
# AL-TAWAKKAL TOURISM — environment variables
# Copy to `.env.local` for local development, or set these under
# Cloudflare Pages → Settings → Environment variables.
#
# NONE of these are required — the project builds and runs with the placeholder
# values in lib/config.ts. Every value below is read at build time.
# -----------------------------------------------------------------------------

# Canonical site URL (used by metadata and the JSON-LD TravelAgency schema)
NEXT_PUBLIC_SITE_URL=https://al-tawakkal-tourism.pages.dev

# Business WhatsApp number — international format, digits only, no "+" or spaces.
# India: 91 followed by the 10-digit mobile number.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Office phone. Used for display and for the tel: links.
NEXT_PUBLIC_PHONE=+91 00000 00000

# Business email address.
NEXT_PUBLIC_EMAIL=info@altawakkaltourism.com

# Google Maps embed URL.
# Get it from Google Maps → Share → Embed a map → Copy HTML → copy the src value.
NEXT_PUBLIC_MAP_EMBED_URL=https://www.google.com/maps?q=Place+Holder+Address&output=embed

# Google Maps shareable link used by the "Open in Google Maps" buttons.
NEXT_PUBLIC_MAP_LINK_URL=https://www.google.com/maps/search/?api=1&query=Place+Holder+Address
